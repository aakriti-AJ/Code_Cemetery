rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  match /project-archives/{userId}/{projectId}/source.zip {
   allow read: if request.auth != null && request.auth.uid == userId;
   allow create, update: if request.auth != null && request.auth.uid == userId
     && request.resource.size <= 20 * 1024 * 1024
     && request.resource.contentType == 'application/zip'
     && firestore.exists(/databases/(default)/documents/projects/$(projectId))
     && firestore.get(/databases/(default)/documents/projects/$(projectId)).data.ownerId == userId;
  }
 }
}
